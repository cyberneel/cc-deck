[Unit]
Description=cc-deck — Claude CLI session dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __CCDECK_DIR__ and __NODE__ are filled in by setup.sh (user services have a minimal PATH,
# so we bake in the absolute node path and the repo's PATH for `claude`/`tmux`).
WorkingDirectory=__CCDECK_DIR__
ExecStart=__NODE__ src/server.js
Restart=on-failure
RestartSec=2
Environment=PATH=__PATH__

[Install]
WantedBy=default.target
