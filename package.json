{
  "name": "cc-deck",
  "version": "0.1.0",
  "type": "module",
  "description": "Web dashboard to view, launch, resume, and attach to Claude CLI sessions (tmux-backed) from the browser.",
  "license": "Apache-2.0",
  "keywords": [
    "claude",
    "claude-code",
    "tmux",
    "terminal",
    "xterm",
    "dashboard",
    "self-hosted"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "bash setup.sh",
    "build": "node esbuild.config.js",
    "start": "node src/server.js",
    "snapshot": "node scripts/snapshot.mjs",
    "dev": "node esbuild.config.js --watch & node --watch src/server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "node-pty": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.25.0"
  }
}
