# Copy to .env and fill in. Never commit .env.

# Password required to log in to the dashboard.
POLYMUX_PASSWORD=change-me

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POLYMUX_SECRET=

# Port the app listens on (behind tailscale serve / cloudflared).
PORT=8787

# Fastify log level (fatal|error|warn|info|debug|trace). Default: info.
# LOG_LEVEL=info

# Interface to bind. Keep 127.0.0.1 so the raw port is NOT exposed on the tailnet;
# access goes only through `tailscale serve` (TLS) or cloudflared.
POLYMUX_BIND=127.0.0.1

# Colon-separated roots under which sessions may be launched/browsed.
# Defaults to $HOME if unset.
POLYMUX_ROOTS=/home/youruser

# Colon-separated dirs to HIDE from the History tab — useful when another app
# runs `claude -p` headlessly in a dir (those transcripts aren't sessions you'd
# attach to). Matches the dir and any subdirectory. Empty = nothing hidden.
# POLYMUX_EXCLUDE_DIRS=/home/youruser/some-app

# Command run inside a Claude session (the default CLI provider).
POLYMUX_LAUNCH=claude

# Polymux is multi-CLI: pick the CLI per session in the New-session dialog. The
# Codex provider's binary + its default approval policy (Codex's "permission mode":
# untrusted|on-failure|on-request|never). Empty approval = Codex's own default.
# POLYMUX_CODEX_LAUNCH=codex
# POLYMUX_CODEX_APPROVAL=on-request
# The Antigravity (agy) CLI provider + its execution mode (accept-edits | plan).
# POLYMUX_AGY_LAUNCH=agy
# POLYMUX_AGY_MODE=accept-edits

# Auto-accept a CLI's "trust this folder?" prompt on launch (the dir is one you
# chose, under POLYMUX_ROOTS). On by default so sessions don't stall/close on it;
# set to off to answer the prompt yourself in the terminal.
# POLYMUX_AUTO_TRUST=off

# Dedicated tmux socket name for Polymux's sessions (isolated from your personal
# `tmux`). The server is kept alive with exit-empty off so removing the last
# session never tears it down. Change only if it collides with another tmux -L.
# POLYMUX_TMUX_SOCKET=ccdeck

# Usage tab pricing source (optional). Token prices are pulled live from this
# structured dataset and cached on disk, so the ROI view doesn't go stale.
# Defaults to the LiteLLM dataset; override only if you mirror it elsewhere.
# POLYMUX_PRICING_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
# POLYMUX_PRICING_TTL_HOURS=168          # how often to refetch (default 7 days)
# POLYMUX_CACHE_DIR=~/.cache/cc-deck     # where the pricing cache is stored

# Static bearer for the MCP endpoint (/mcp): full access, including the session-control
# tools (create / resume / drive sessions, read their files). Empty = the bearer path is
# off; Claude.ai connectors can still sign in over OAuth (read + notes only).
# POLYMUX_MCP_TOKEN=generate-a-long-random-string

# Public origin for OAuth metadata (claude.ai connector). Auto-derived from
# request headers behind Cloudflare; set explicitly only if that is ever wrong.
# POLYMUX_PUBLIC_URL=https://claude.example.com

# Session restore across host reboots. Polymux snapshots active sessions
# (periodically, on graceful stop, and via `npm run snapshot`) and relaunches
# them with `claude --resume` on next startup IF no sessions are already running.
# POLYMUX_MAX_SESSIONS=3                                 # cap running sessions (small box); Friday's starts queue for a slot
# POLYMUX_RESTORE=off                                   # disable restore-on-boot
# POLYMUX_RESTORE_FILE=~/.claude/cc-deck/restore.json   # snapshot location

# Self-host update check: `git fetch` the upstream branch every 6h and show an
# "Update" pill when there are new commits (apply with ./update.sh). Always off on
# hosted tenants (POLYMUX_TENANT_ID set) and on non-git installs (Docker).
# POLYMUX_UPDATE_CHECK=off

# Read-only MCP bearer + auto-wire new sessions with it (handoff-aware: search +
# save-note + list-sessions, NOT create/send). Sessions can discover siblings +
# leave cross-session notes. Wired into EVERY CLI: Claude (--mcp-config, per
# launch), Codex (per-launch `-c mcp_servers.*`, bearer via the POLYMUX_RO env var
# Polymux exports on the launch line), and agy (registered once at startup via
# `agy mcp add`, since agy has no per-launch MCP flag — persists in agy's config).
# POLYMUX_MCP_TOKEN_READONLY=generate-a-long-random-string
# POLYMUX_SESSION_MCP=on

# Permission mode each new session starts in (Claude --permission-mode):
# acceptEdits | auto | plan | bypassPermissions | manual | default. Empty = Claude default.
# Users can still cycle with shift+tab in-session.
# POLYMUX_PERMISSION_MODE=auto

# Remote hosts whose tmux sessions Polymux lists + attaches over SSH (tailnet).
# Comma/space-separated: "sshTarget" or "label=sshTarget". Needs key-based SSH,
# and the remote session must be running inside tmux to be attachable.
# POLYMUX_REMOTE_HOSTS=laptop=cyber@laptop.tailnet.ts.net dell-arch-cyber

# Auto-wire every new session with the SHARED logged-in browser (chrome-devtools-mcp
# -> POLYMUX_BROWSER_CDP) + a coordination nudge, so sessions share one browser via
# Polymux's lock registry (browser_tabs/claim/release) instead of colliding.
# POLYMUX_SESSION_BROWSER=on
# POLYMUX_BROWSER_CDP=http://127.0.0.1:9222

# Origins allowed to iframe Polymux (CSP frame-ancestors), for embedding it in a
# parent hub/dashboard. Space/comma-separated bare origins. Unset = same-origin
# framing only, which blocks cross-origin clickjacking (the safe default).
# POLYMUX_FRAME_ANCESTORS=https://hub.example.com

# Push a session's "needs your input" transition to Friday's Reach Manager the instant it
# happens, so Friday reacts without polling Polymux. Opt-in: unset = disabled (Polymux runs
# standalone). Point the URL at Friday's /api/reach and the password at Friday's app password.
# POLYMUX_FRIDAY_REACH_URL=http://127.0.0.1:8790/api/reach
# POLYMUX_FRIDAY_REACH_PASSWORD=your-friday-app-password
